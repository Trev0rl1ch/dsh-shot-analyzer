{
  "name": "dsh-shot-analyzer",
  "version": "0.1.0",
  "description": "DSH 截图分析插件：输入框旁的按钮一键抓取全屏截图，并把图片作为用户消息发进当前会话，让 Agent 直接分析画面",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "vision"
  ],
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
